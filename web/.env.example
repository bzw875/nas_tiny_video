# 浏览器请求的 API 根路径，默认 /api，经 Vite 或生产反向代理访问网关。
VITE_API_BASE=/api

# 仅用于 npm run dev 的 Vite 代理目标，指向 Spring Cloud Gateway。
VITE_GATEWAY_TARGET=http://127.0.0.1:4000

# 前后端不同域部署时改成带 /api 的完整网关地址：
# VITE_API_BASE=https://api.example.com/api

# AgiexMonitor 上报网关（必填后才会启动 SDK）
# VITE_MONITOR_APP_ID=nas-tiny-video
# VITE_MONITOR_REPORT_URL=https://monitor.example.com
# VITE_MONITOR_DEBUG=true
# VITE_MONITOR_WHITE_SCREEN=true
