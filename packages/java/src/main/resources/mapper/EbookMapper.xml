<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.videomanager.ebooks.EbookMapper">

    <sql id="ebookColumns">
        e.id,
        e.title,
        e.author,
        e.file_path,
        e.format,
        e.size_bytes,
        e.created_at,
        e.modified_at
    </sql>

    <sql id="ebookWhere">
        <where>
            <if test="search != null and search != ''">
                AND (e.title LIKE #{search} OR e.author LIKE #{search})
            </if>
        </where>
    </sql>

    <select id="selectPage" resultType="java.util.HashMap">
        SELECT
        <include refid="ebookColumns"/>
        FROM ebooks e
        <include refid="ebookWhere"/>
        ${orderBySql}
        LIMIT #{skip}, #{take}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*)
        FROM ebooks e
        <include refid="ebookWhere"/>
    </select>

    <select id="selectById" resultType="java.util.HashMap">
        SELECT
        <include refid="ebookColumns"/>
        FROM ebooks e
        WHERE e.id = #{id}
    </select>

    <insert id="insertEbook">
        INSERT INTO ebooks (title, author, file_path, format, size_bytes, created_at, modified_at)
        VALUES (#{title}, #{author}, #{filePath}, #{format}, #{sizeBytes}, NOW(), NOW())
    </insert>

    <update id="updateEbook">
        UPDATE ebooks
        SET title       = #{title},
            author      = #{author},
            file_path   = #{filePath},
            format      = #{format},
            size_bytes  = #{sizeBytes},
            modified_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ebooks WHERE id = #{id}
    </delete>
</mapper>
