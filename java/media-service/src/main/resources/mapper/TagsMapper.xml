<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.videomanager.tags.TagsMapper">

    <select id="findAll" resultType="com.videomanager.tags.dto.TagDto">
        SELECT id, name, description, created_at, updated_at
        FROM tags
        ORDER BY name ASC
    </select>

    <select id="findById" resultType="com.videomanager.tags.dto.TagDto">
        SELECT id, name, description, created_at, updated_at
        FROM tags
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tags (name, description) VALUES (#{name}, #{description})
    </insert>

    <update id="update">
        UPDATE tags SET name = #{name}, description = #{description} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM tags WHERE id = #{id}
    </delete>
</mapper>
